# Copy to .env and fill in. The agent also runs without a key in replay mode.
# Get a key at https://z.ai (OpenAI-compatible endpoint)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5-turbo

# Optional: protects the web API (not the HTML pages) with a shared token.
# Set it whenever the console is reachable beyond localhost (VM / AWS / club box).
# Clients must then send: X-API-Token: <same value>
CLUBSTEWARD_WEB_TOKEN=
